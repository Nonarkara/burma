/*
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Content-Security-Policy: base-uri 'self'; object-src 'none'; form-action 'self'
  Permissions-Policy: camera=(), microphone=()

# Scripts and styles keep their plain filenames — there is no content hash to
# bust a cache with, so they must revalidate on every load. Without this the
# edge default (max-age=14400) serves four hours of stale JS after a deploy,
# which is exactly what happened on 2026-10-29.
/*.js
  Cache-Control: no-cache

/*.css
  Cache-Control: no-cache
